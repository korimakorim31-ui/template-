# Application Settings
APP_NAME="Random Joke Generator API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
APP_PORT=8001
WORKERS=4

# Database
DATABASE_URL=sqlite:///./jokes.db
# For PostgreSQL: postgresql://user:password@localhost/jokes_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Caching
JOKE_CACHE_TTL=3600
CACHE_ENABLED=True

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
RATE_LIMITING_ENABLED=True

# External APIs
JOKE_API_TIMEOUT=10
JOKE_API_RETRIES=3
FALLBACK_ENABLED=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
SECRET_KEY=your-secret-key-change-in-production

# Feature Flags
ENABLE_WEBSOCKET=True
ENABLE_TRANSLATIONS=True
ENABLE_USER_RATINGS=True
ENABLE_FAVORITES=True
